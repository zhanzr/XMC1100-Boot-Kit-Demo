  153 00000000         
  154 00000000         ; Following code initializes the Veneers at address 0x200
                       00000 with a "branch to itself"
  155 00000000         ; The real veneers will be copied later from the scatter 
                       loader before reaching main.
  156 00000000         ; This init code should handle an exception before the re
                       al veneers are copied.
  157 00000000 20000000 
                       SRAM_BASE
                               EQU              0x20000000
  158 00000000 E7FEBF00 
                       VENEER_INIT_CODE
                               EQU              0xE7FEBF00  ; NOP, B .
  159 00000000         



