   72 00000200         ; <h> Clock system handling by SSW
   73 00000200         ;   <h> CLK_VAL1 Configuration
   74 00000200         ;    <o0.0..7>    FDIV Fractional Divider Selection
   75 00000200         ;    <i> Deafult: 0. Fractional part of clock divider, MC
                       LK = DCO1 / (2 x (IDIV + (FDIV / 256)))
   76 00000200         ;    <o0.8..15>   IDIV Divider Selection (limited to 1-16
                       )
   77 00000200         ;                    <0=> Divider is bypassed
   78 00000200         ;                    <1=> MCLK = 32 MHz
   79 00000200         ;                    <2=> MCLK = 16 MHz
   80 00000200         ;                    <3=> MCLK = 10.67 MHz
   81 00000200         ;                    <4=> MCLK = 8 MHz
   82 00000200         ;                    <254=> MCLK = 126 kHz
   83 00000200         ;                    <255=> MCLK = 125.5 kHz
   84 00000200         ;    <i> Deafult: 4. Interger part of clock divider, MCLK
                        = DCO1 / (2 x (IDIV + (FDIV / 256))) = 8MHz
   85 00000200         ;    <o0.16>      PCLKSEL PCLK Clock Select
   86 00000200         ;                    <0=> PCLK = MCLK
   87 00000200         ;                    <1=> PCLK = 2 x MCLK
   88 00000200         ;    <i> Deafult: 2 x MCLK
   89 00000200         ;    <o0.17..19>  RTCCLKSEL RTC Clock Select
   90 00000200         ;                    <0=> 32.768kHz standby clock
   91 00000200         ;                    <1=> 32.768kHz external clock from E
                       RU0.IOUT0
   92 00000200         ;                    <2=> 32.768kHz external clock from A
                       CMP0.OUT
   93 00000200         ;                    <3=> 32.768kHz external clock from A
                       CMP1.OUT
   94 00000200         ;                    <4=> 32.768kHz external clock from A
                       CMP2.OUT
   95 00000200         ;                    <5=> Reserved
   96 00000200         ;                    <6=> Reserved
   97 00000200         ;                    <7=> Reserved
   98 00000200         ;    <i> Deafult: 32.768kHz standby clock 
   99 00000200         ;    <o0.31>      do not move CLK_VAL1 to SCU_CLKCR[0..19
                       ]
